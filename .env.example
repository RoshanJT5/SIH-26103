DATABASE_URL=sqlite:///./database/project_monitoring.db
GROQ_API_KEY=
# Production Groq model with tool use and strict structured-output support.
GROQ_MODEL=openai/gpt-oss-20b
APP_ENV=development
LOG_LEVEL=INFO
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-a-local-env
ADMIN_TOKEN_TTL_SECONDS=1800
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
